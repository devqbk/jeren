# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno. Copiar a .env.local para desarrollo, y cargarlas en
# Vercel (Project Settings → Environment Variables) para producción.
# ─────────────────────────────────────────────────────────────────────────────

# ── Envío de mail de los formularios ─────────────────────────────────────────
# Qué proveedor usar: "resend" o "sendgrid". Si se deja vacío, se elige solo
# según qué API key esté cargada, probando Resend primero. Cambiar de proveedor
# es cargar esta variable y redeployar: no hay que tocar código.
MAIL_PROVIDER=

# Credenciales. Alcanza con la del proveedor que se vaya a usar.
RESEND_API_KEY=
SENDGRID_API_KEY=

# A dónde llegan las consultas. Acepta varias separadas por coma.
CONTACT_TO_EMAILS=

# Remitente. Los dos proveedores exigen un dominio verificado en su panel.
# Mientras jeren.com no lo esté en Resend, dejar esto VACÍO: se usa
# onboarding@resend.dev, que solo entrega a la casilla dueña de la cuenta.
# Con SendGrid no hay default: sin esto el envío falla.
MAIL_FROM=

# ── Antispam (Cloudflare Turnstile) ──────────────────────────────────────────
# OJO: van las dos o ninguna. Si está solo la del server, el server exige un
# token que el cliente nunca puede generar y TODOS los envíos se rechazan.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Opcional: el ID ya está por defecto en components/analytics/ga4.tsx (es
# público, viaja en el HTML). Solo hace falta para apuntar a otra propiedad.
NEXT_PUBLIC_GA4_ID=

# ── Google Tag Manager ───────────────────────────────────────────────────────
# Opcional: el ID ya está por defecto en components/analytics/gtm.tsx.
# Solo hace falta para apuntar a otro contenedor. Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
