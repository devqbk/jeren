# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno. Copiar a .env.local para desarrollo, y cargarlas en
# Vercel (Project Settings → Environment Variables) para producción.
# ─────────────────────────────────────────────────────────────────────────────

# ── Formulario de contacto y de CIMAT ────────────────────────────────────────
# Sin estas tres el formulario devuelve error y ofrece el teléfono como
# alternativa. No rompe la página, pero no entra ningún lead.
SENDGRID_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAILS=

# ── Antispam (Cloudflare Turnstile) ──────────────────────────────────────────
# OJO: van las dos o ninguna. Si está solo la del server, el server exige un
# token que el cliente nunca puede generar y TODOS los envíos se rechazan.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Google Tag Manager ───────────────────────────────────────────────────────
# Sin esto no hay medición de conversiones: Google Ads no puede optimizar y
# Smart Bidding no arranca. Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
