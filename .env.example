# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno. Copiar a .env.local para desarrollo, y cargarlas en
# Vercel (Project Settings → Environment Variables) para producción.
# ─────────────────────────────────────────────────────────────────────────────

# ── Formulario de contacto y de CIMAT (Resend) ───────────────────────────────
# Sin estas dos el formulario devuelve error y ofrece el teléfono como
# alternativa. No rompe la página, pero no entra ningún lead.
RESEND_API_KEY=
CONTACT_TO_EMAILS=

# Remitente. Resend solo deja mandar desde un dominio verificado en su panel.
# Mientras jeren.com no lo esté, dejar esto VACÍO: se usa onboarding@resend.dev,
# que solo entrega a la casilla dueña de la cuenta de Resend.
MAIL_FROM=

# ── Antispam (Cloudflare Turnstile) ──────────────────────────────────────────
# OJO: van las dos o ninguna. Si está solo la del server, el server exige un
# token que el cliente nunca puede generar y TODOS los envíos se rechazan.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Opcional: el ID ya está por defecto en components/analytics/ga4.tsx (es
# público, viaja en el HTML). Solo hace falta para apuntar a otra propiedad.
NEXT_PUBLIC_GA4_ID=

# ── Google Tag Manager ───────────────────────────────────────────────────────
# Opcional: el ID ya está por defecto en components/analytics/gtm.tsx.
# Solo hace falta para apuntar a otro contenedor. Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
